[
 {
  "name": "list_profiles",
  "description": "List saved website logins: name, account (e.g. the email), site, allowed domains, read-only.\nA login is cookies plus the site's storage (localStorage, IndexedDB, sessionStorage); many apps\n(Discord, WhatsApp Web, Teams) keep the sign-in in storage, so a low cookie count is normal.\n\nsite: only logins for this site, e.g. \"google.com\" or \"linkedin\". A site can have several accounts.\n",
  "inputSchema": {
   "properties": {
    "site": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Site"
    }
   },
   "title": "list_profilesArguments",
   "type": "object"
  },
  "outputSchema": {
   "properties": {
    "result": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "Result",
     "type": "array"
    }
   },
   "required": [
    "result"
   ],
   "title": "list_profilesOutput",
   "type": "object"
  },
  "annotations": {
   "readOnlyHint": true,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false
  }
 },
 {
  "name": "start_login",
  "description": "Open a visible browser window so the USER can log in to a site by hand.\n\nurl: the site's login page or home page.\nprofile: name to save it under, e.g. \"work-gmail\". Leave empty to name it after the account that\n  signs in (its email when the site shows one). Log in again with no name to add another account\n  for the same site.\nallowed_domains: domains agents may navigate to with this session\n  (defaults to the url's base domain, e.g. [\"github.com\"]).\nread_only: agents can browse and read with this profile but never type, submit, send or buy.\nThe agent never sees the password. Call complete_login once the user says they're done.\n",
  "inputSchema": {
   "properties": {
    "url": {
     "title": "Url",
     "type": "string"
    },
    "profile": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Profile"
    },
    "allowed_domains": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Allowed Domains"
    },
    "read_only": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Read Only"
    }
   },
   "required": [
    "url"
   ],
   "title": "start_loginArguments",
   "type": "object"
  },
  "outputSchema": {
   "properties": {
    "result": {
     "title": "Result",
     "type": "string"
    }
   },
   "required": [
    "result"
   ],
   "title": "start_loginOutput",
   "type": "object"
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": true
  }
 },
