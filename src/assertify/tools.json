  "name": "click",
  "description": "Click an element: `ref` from the latest snapshot (e.g. \"e12\"), or its visible `text`\n(e.g. \"Messages\"), which keeps working when the page layout changes.\n\nconfirmed: set to true only after the user approved this exact action. Buttons that send, post,\n  buy, delete, connect, etc. are paused until then.\naccept_dialog: if the click opens an \"Are you sure?\" browser box, press OK instead of Cancel.\ndialog_text: if the click opens a browser box that asks for text (a prompt), type this and press OK.\n",
  "inputSchema": {
   "properties": {
    "session_id": {
     "title": "Session Id",
     "type": "string"
    },
    "ref": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Ref"
    },
    "text": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Text"
    },
    "confirmed": {
     "default": false,
