 {
  "name": "browser_settings",
  "description": "For sites that show the BROWSER's own sign-in box (HTTP Basic/NTLM, common on intranets,\nrouters and old admin pages) or use a self-signed certificate: open a small window where the\nUSER types that username and password and can choose to trust the site's certificate.\n\nprofile: the saved login to add these to. If it doesn't exist yet, give `url` and a new login\n  is set up for that site (useful when the browser box is the only sign-in).\nurl: the site's address; also limits the password to that exact site.\nYou never see what the user types; it's saved encrypted with the login. Waits until they\nsave or close the window (up to 10 minutes).\n",
  "inputSchema": {
   "properties": {
    "profile": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Profile"
    },
    "url": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Url"
    }
   },
   "title": "browser_settingsArguments",
   "type": "object"
  },
  "outputSchema": {
   "properties": {
    "result": {
     "title": "Result",
     "type": "string"
    }
   },
   "required": [
    "result"
   ],
   "title": "browser_settingsOutput",
   "type": "object"
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": true
  }
 },
